# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=textsql
POSTGRES_PASSWORD=textsql_secret
POSTGRES_DB=chinook
READONLY_PASSWORD=readonly_secret

# Full DB access (for schema introspection + admin)
DATABASE_URL=postgresql+psycopg2://textsql:textsql_secret@localhost:5432/chinook

# Read-only DB access (for query execution — sandboxed)
READ_ONLY_DATABASE_URL=postgresql+asyncpg://textsql_readonly:readonly_secret@localhost:5432/chinook

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Choose one: "groq" (recommended, free) or "gemini" (free alternative)
LLM_PROVIDER=groq

# Groq Free Tier — get key at: https://console.groq.com
# Model: llama-3.3-70b-versatile (great for SQL, free tier: 14,400 req/day)
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# Google Gemini Free Tier — get key at: https://aistudio.google.com
# Uncomment below and set LLM_PROVIDER=gemini to use instead
# GEMINI_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-2.0-flash

# ─── Pipeline Settings ────────────────────────────────────────────────────────
MAX_RESULT_ROWS=500
GUARDRAIL_MAX_SUBQUERY_DEPTH=3
GUARDRAIL_ENFORCE_LIMIT=true
SCHEMA_SIMILARITY_THRESHOLD=0.25
